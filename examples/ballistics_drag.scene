# Сцена: баллистика с квадратичным сопротивлением (блок A3).
# Грамматика фиксируется в блоке A.

meta:
    integrator: verlet-velocity
    dt: 0.0041666667
    duration: 5.0

bodies:
    - id: 0
      mass: 0.145          # бейсбольный мяч, кг
      radius: 0.0366
      pos: [0.0, 1.7]      # рост бросающего, м
      vel: [40.0, 20.0]    # ~44.7 м/с под углом ~27°

forces:
    - gravity: { g: [0.0, -9.81] }
    - drag_quadratic: { k2: 0.00115 }   # ½·ρ·C·A для мяча

record:
    csv: ballistics.csv
    every: 0.02
